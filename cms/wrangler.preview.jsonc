{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tagg-cms-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@aws-sdk/xml-builder": "./aws-xml-builder.mjs",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tagg-cms-preview",
      "database_id": "REPLACE_WITH_DISPOSABLE_D1_DATABASE_ID",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tagg-cms-preview-media",
    },
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "tagg-cms-preview-private",
    },
  ],
  "vars": {
    "ENVIRONMENT": "preview",
    "CMS_STORAGE_PREFIX": "cms-preview",
    "R2_BUCKET_NAME": "tagg-cms-preview-media",
    "R2_PRIVATE_BUCKET_NAME": "tagg-cms-preview-private",
    "R2_PUBLIC_BASE_URL": "",
    "PUBLIC_SITE_URL": "",
    "ALLOWED_EDITOR_EMAILS": "",
  },
}
