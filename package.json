{
  "name": "tagg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "media:sync": "node scripts/sync-media-catalog.mjs",
    "media:migrate": "node scripts/migrate-vimeo-to-cloudflare.mjs",
    "media:migrate:dry": "node scripts/migrate-vimeo-to-cloudflare.mjs --dry-run",
    "media:migrate:check": "node scripts/migrate-vimeo-to-cloudflare.mjs --dry-run --check-source --limit=1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-modal": "^3.16.3",
    "react-player": "^2.16.1",
    "react-responsive-carousel": "^3.2.23",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
