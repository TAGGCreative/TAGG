# Used only by the one-time Vimeo catalog sync and R2 migration scripts.
ACCESS_TOKEN=
TAGG_ID=

# Create an R2 API token with Object Read & Write permission for the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tagg-media

# Add an R2 custom domain first, e.g. https://media.taggcreative.com
R2_PUBLIC_BASE_URL=
