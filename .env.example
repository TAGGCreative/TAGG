# Used only by the one-time Vimeo catalog sync and R2 migration scripts.
ACCESS_TOKEN=
TAGG_ID=

# Create an R2 API token with Object Read & Write permission for the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tagg-media

# Add an R2 custom domain first, e.g. https://media.taggcreative.com
R2_PUBLIC_BASE_URL=

# Public site CMS integration. The content base normally points at the R2
# custom domain, e.g. https://media.taggcreative.com/cms.
CMS_CONTENT_BASE_URL=
CMS_PUBLISHED_CONTENT_URL=
CMS_PREVIEW_SECRET=
CMS_REVALIDATE_SECRET=

# Mac media helper. CMS_API_URL is normally https://cms.taggcreative.com.
CMS_API_URL=
CMS_PROCESSOR_TOKEN=
